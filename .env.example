# Copy this file to .env (gitignored) and fill in real values.
# `make build` / `make serve` read .env automatically and pass the relevant
# variables through to Hugo at build time. Never commit a filled-in .env.
#
# Production (Cloudflare Pages) builds use the same contact variables as
# GitHub Actions repository secrets — see README "Deploy (Cloudflare Pages)".
# Do not put Cloudflare API tokens in this file; those belong only in GH secrets.

# --- docker-compose (optional local / legacy tunnel) ----------------------
# Tunnel token for the cloudflared container in compose.yml. Not used by
# Cloudflare Pages production; keep only if you still run the tunnel locally.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Contact form (Phase 4 / Creative C5) -------------------------------
# Full HTTPS URL of the n8n webhook that receives contact-form POSTs.
# Leave blank for local/dev builds: the form still renders, but has no
# action URL, and the page notes that submissions aren't wired.
# Production: set the same value as GH secret N8N_CONTACT_WEBHOOK_URL.
N8N_CONTACT_WEBHOOK_URL=

# Cloudflare Turnstile PUBLIC site key (safe to ship in built HTML).
# The matching Turnstile SECRET key is verified inside the n8n workflow
# only — it is never read by Hugo and must never go in this repo.
# Production: set the same value as GH secret TURNSTILE_SITE_KEY.
TURNSTILE_SITE_KEY=
